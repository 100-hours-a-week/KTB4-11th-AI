{
  "family": "stockspoon-v2-prod-market-http",
  "taskRoleArn": "arn:aws:iam::250832562715:role/stockspoon-v2-prod-market-http-task-role",
  "executionRoleArn": "arn:aws:iam::250832562715:role/stockspoon-v2-prod-ecs-task-execution-role",
  "networkMode": "awsvpc",
  "containerDefinitions": [
    {
      "name": "market-http",
      "image": "IMAGE_SET_BY_CD",
      "cpu": 0,
      "portMappings": [
        {
          "containerPort": 8000,
          "hostPort": 8000,
          "protocol": "tcp"
        }
      ],
      "essential": true,
      "command": [
        "market-http"
      ],
      "environment": [
        {
          "name": "MARKET_HTTP_HOST",
          "value": "0.0.0.0"
        },
        {
          "name": "MARKET_HTTP_QUESTDB_CONF",
          "value": "ws::addr=10.0.1.75:9000;"
        },
        {
          "name": "MARKET_HTTP_VALKEY_HOST",
          "value": "stockspoon-v2-prod-valkey-kmikux.serverless.apn2.cache.amazonaws.com"
        },
        {
          "name": "MARKET_HTTP_LOG_LEVEL",
          "value": "INFO"
        },
        {
          "name": "MARKET_HTTP_VALKEY_TLS",
          "value": "true"
        },
        {
          "name": "MARKET_HTTP_CORS_ORIGINS",
          "value": "[\"*\"]"
        },
        {
          "name": "MARKET_HTTP_DOCS_PATH_PREFIX",
          "value": "/market"
        },
        {
          "name": "MARKET_HTTP_VALKEY_CACHE_NAME",
          "value": "stockspoon-v2-prod-valkey"
        },
        {
          "name": "MARKET_HTTP_CORS_HEADERS",
          "value": "[\"*\"]"
        },
        {
          "name": "MARKET_HTTP_PORT",
          "value": "8000"
        },
        {
          "name": "MARKET_HTTP_DOCS_ENABLED",
          "value": "true"
        },
        {
          "name": "MARKET_HTTP_VALKEY_PORT",
          "value": "6379"
        },
        {
          "name": "MARKET_HTTP_VALKEY_USERNAME",
          "value": "stockspoon-v2-prod-valkey-socket"
        },
        {
          "name": "MARKET_HTTP_AWS_REGION",
          "value": "ap-northeast-2"
        },
        {
          "name": "MARKET_HTTP_VALKEY_AUTH_MODE",
          "value": "iam"
        },
        {
          "name": "MARKET_HTTP_METRICS_NAMESPACE",
          "value": "StockSpoon/ECS"
        },
        {
          "name": "MARKET_HTTP_METRICS_CLUSTER_NAME",
          "value": "stockspoon-v2-prod-cluster"
        },
        {
          "name": "MARKET_HTTP_METRICS_SERVICE_NAME",
          "value": "stockspoon-v2-prod-market-http"
        },
        {
          "name": "MARKET_HTTP_VALKEY_MAX_CONNECTIONS",
          "value": "1000"
        }
      ],
      "mountPoints": [],
      "volumesFrom": [],
      "stopTimeout": 30,
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/stockspoon-v2-prod/market-http",
          "awslogs-region": "ap-northeast-2",
          "awslogs-stream-prefix": "market-http"
        }
      },
      "healthCheck": {
        "command": [
          "CMD-SHELL",
          "python -c \"import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/health', timeout=3)\" || exit 1"
        ],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 30
      },
      "systemControls": []
    }
  ],
  "volumes": [],
  "placementConstraints": [],
  "requiresCompatibilities": [
    "EC2"
  ],
  "cpu": "2048",
  "memory": "4096",
  "runtimePlatform": {
    "cpuArchitecture": "X86_64",
    "operatingSystemFamily": "LINUX"
  }
}
