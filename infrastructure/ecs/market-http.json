{
  "family": "stockspoon-v2-prod-market-http",
  "taskRoleArn": "arn:aws:iam::250832562715:role/stockspoon-v2-prod-market-http-task-role",
  "executionRoleArn": "arn:aws:iam::250832562715:role/stockspoon-v2-prod-ecs-task-execution-role",
  "networkMode": "awsvpc",
  "containerDefinitions": [
    {
      "name": "market-http",
      "image": "IMAGE_SET_BY_CD",
      "cpu": 0,
      "portMappings": [
        {
          "containerPort": 8000,
          "hostPort": 8000,
          "protocol": "tcp"
        }
      ],
      "essential": true,
      "command": [
        "market-http"
      ],
      "environment": [],
      "mountPoints": [],
      "volumesFrom": [],
      "stopTimeout": 30,
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/stockspoon-v2-prod/market-http",
          "awslogs-region": "ap-northeast-2",
          "awslogs-stream-prefix": "market-http"
        }
      },
      "healthCheck": {
        "command": [
          "CMD-SHELL",
          "python -c \"import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/health', timeout=3)\" || exit 1"
        ],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 30
      },
      "systemControls": [],
      "secrets": []
    }
  ],
  "volumes": [],
  "placementConstraints": [],
  "requiresCompatibilities": [
    "EC2"
  ],
  "cpu": "1024",
  "memory": "2048",
  "runtimePlatform": {
    "cpuArchitecture": "X86_64",
    "operatingSystemFamily": "LINUX"
  }
}
