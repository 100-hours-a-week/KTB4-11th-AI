[Unit]
Description=KTB hourly news preprocessing job
Wants=network-online.target
After=network-online.target docker.service
Requires=docker.service
# 작업 결과를 AI_CWAgent/ScheduledJobFailure(JobName=news-preprocessor)로 발행합니다.
OnSuccess=ktb-scheduled-job-success@news-preprocessor.service
OnFailure=ktb-scheduled-job-failure@news-preprocessor.service
StartLimitIntervalSec=1h
StartLimitBurst=3

[Service]
Type=oneshot
User=@@DEPLOY_USER@@
WorkingDirectory=@@DEPLOY_DIR@@
ExecStart=/usr/bin/flock -n -E 0 @@DEPLOY_DIR@@/.news-preprocessor.lock /usr/bin/docker compose --env-file .env --env-file .image.env -f compose.prod.yaml run --rm -T news-preprocessor
TimeoutStartSec=50m
Restart=on-failure
# 재시도 중간 실패는 failed 상태를 거치지 않게 해 OnFailure=가 최종 실패에만 실행되게 합니다.
RestartMode=direct
RestartSec=5m
KillMode=mixed
