[Unit]
Description=Run KTB portfolio rebalancer hourly through the KRX session

[Timer]
# KRX opens at 09:00 and closes at 15:30, and the last band goes to market at 15:00,
# so 09:00..15:00 is every pass the service has anything to decide with. A tick outside
# those hours would still send orders, against a market that is shut.
OnCalendar=Mon..Fri *-*-* 09..15:00:00 Asia/Seoul
AccuracySec=1s
Persistent=false
Unit=ktb-portfolio-rebalancer.service

[Install]
WantedBy=timers.target
