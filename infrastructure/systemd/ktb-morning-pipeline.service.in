[Unit]
Description=KTB pre-market portfolio pipeline
Wants=network-online.target
After=network-online.target docker.service
Requires=docker.service
# 작업 결과를 AI_CWAgent/ScheduledJobFailure(JobName=morning-pipeline)로 발행합니다.
OnSuccess=ktb-scheduled-job-success@morning-pipeline.service
OnFailure=ktb-scheduled-job-failure@morning-pipeline.service
StartLimitIntervalSec=1h
StartLimitBurst=3

[Service]
Type=oneshot
User=@@DEPLOY_USER@@
WorkingDirectory=@@DEPLOY_DIR@@
ExecStart=/usr/bin/flock -n -E 0 @@DEPLOY_DIR@@/.morning-pipeline.lock @@DEPLOY_DIR@@/scripts/run-morning-pipeline.sh
TimeoutStartSec=2h50m
Restart=on-failure
# 재시도 중간 실패는 failed 상태를 거치지 않게 해 OnFailure=가 최종 실패에만 실행되게 합니다.
RestartMode=direct
RestartSec=5m
KillMode=mixed
