[Unit]
Description=KTB realtime market price stream
Wants=network-online.target
After=network-online.target docker.service
Requires=docker.service
# 작업 결과를 AI_CWAgent/ScheduledJobFailure(JobName=market-streamer)로 발행합니다.
OnSuccess=ktb-scheduled-job-success@market-streamer.service
OnFailure=ktb-scheduled-job-failure@market-streamer.service
StartLimitIntervalSec=1h
StartLimitBurst=5

[Service]
Type=simple
User=@@DEPLOY_USER@@
WorkingDirectory=@@DEPLOY_DIR@@
ExecStart=/usr/bin/flock -n -E 0 @@DEPLOY_DIR@@/.market-streamer.lock /usr/bin/docker compose --env-file .env --env-file .image.env -f compose.prod.yaml run --rm --no-deps --service-ports -T market-streamer
Restart=on-failure
RestartMode=direct
RestartSec=1m
TimeoutStopSec=2m
KillMode=mixed
