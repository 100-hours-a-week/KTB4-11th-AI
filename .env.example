# =============================================================================
#  Environment variables
# =============================================================================
#  1. Copy this file to .env and fill in the empty values.
#  2. Never commit .env or any credential.
#
#  Uncommented lines   required by Compose
#  Commented lines     optional; the value shown is the default
#
#  Each service reads its own prefix through pydantic-settings.
#  Compose builds every *_POSTGRES_DSN from the POSTGRES_* values below.
# =============================================================================


# -----------------------------------------------------------------------------
#  Compose datastores
# -----------------------------------------------------------------------------
POSTGRES_USER=ktb
POSTGRES_DB=ktb
POSTGRES_PASSWORD=

# QuestDB PGWire credentials
QUESTDB_USER=admin
QUESTDB_PASSWORD=

# Production only: private IP that PostgreSQL 5432 and QuestDB 9000 are published on
# for the V2 ECS market services. Defaults to 127.0.0.1 (development).
# AI_PRIVATE_IP=127.0.0.1


# -----------------------------------------------------------------------------
#  Tooling (run outside Compose)
# -----------------------------------------------------------------------------
# alembic upgrade head
# KTB_POSTGRES_DSN=postgresql+psycopg://ktb:ktb@localhost:5432/ktb

# infrastructure/questdb/migrate.py
# KTB_QUESTDB_CONF=ws::addr=localhost:9000;

# DB tests; skipped when unset. They TRUNCATE tables: use ktb_test, never ktb
# KTB_TEST_POSTGRES_DSN=postgresql+psycopg://ktb:ktb@localhost:5432/ktb_test

# Valkey tests; skipped when unset. They FLUSHDB: use a dedicated instance
# KTB_TEST_VALKEY_URL=redis://localhost:6379/0


# -----------------------------------------------------------------------------
#  Embedding (news-preprocessor, news-clusterer)
# -----------------------------------------------------------------------------
# Required: OpenAI-compatible server, including /v1
KTB_EMBEDDING_BASE_URI=

# Sent as Authorization: Bearer when set (e.g. OpenRouter).
# Leave unset for a keyless local server.
# KTB_EMBEDDING_API_KEY=

# KTB_EMBEDDING_MODEL=mlx-community/Qwen3-Embedding-4B-4bit-DWQ
# KTB_EMBEDDING_MAX_TOKENS=16384

# Must equal the vector(2000) column
# KTB_EMBEDDING_DIMENSIONS=2000


# -----------------------------------------------------------------------------
#  news-preprocessor
# -----------------------------------------------------------------------------
# Required: OpenDART API key
NEWS_PREPROCESSOR_DART_API_KEY=

# NEWS_PREPROCESSOR_EMBED_BATCH_LIMIT=100
# NEWS_PREPROCESSOR_EMBED_TIMEOUT=120
# NEWS_PREPROCESSOR_USER_AGENT=ktb-ai/0.1
# NEWS_PREPROCESSOR_LOG_LEVEL=INFO


# -----------------------------------------------------------------------------
#  news-clusterer
# -----------------------------------------------------------------------------
# DBSCAN cosine distance (0 < eps <= 2).
# Tuned for Qwen3-Embedding-4B; recalibrate when the model changes.
# NEWS_CLUSTERER_EPS=0.36

# NEWS_CLUSTERER_MIN_SAMPLES=2
# NEWS_CLUSTERER_LOG_LEVEL=INFO


# -----------------------------------------------------------------------------
#  news-graph-builder
# -----------------------------------------------------------------------------
# Required: OpenAI-compatible LLM server (including /v1) and model id
NEWS_GRAPH_BUILDER_LLM_BASE_URI=
NEWS_GRAPH_BUILDER_LLM_MODEL=

# Sent as Authorization: Bearer when set. Leave unset for a keyless local vLLM.
# NEWS_GRAPH_BUILDER_LLM_API_KEY=

# Article text cap sent to the LLM (characters)
# NEWS_GRAPH_BUILDER_SUMMARY_MAX_CHARS=24000

# LLM request timeout (seconds)
# NEWS_GRAPH_BUILDER_LLM_TIMEOUT=120

# Per-cluster caps
# NEWS_GRAPH_BUILDER_MAX_ENTITIES=30
# NEWS_GRAPH_BUILDER_MAX_RELATIONS=50

# NEWS_GRAPH_BUILDER_LOG_LEVEL=INFO


# -----------------------------------------------------------------------------
#  news-http
# -----------------------------------------------------------------------------
# NEWS_HTTP_HOST=0.0.0.0
# NEWS_HTTP_PORT=8000
# NEWS_HTTP_LOG_LEVEL=INFO


# -----------------------------------------------------------------------------
#  market-syncer
# -----------------------------------------------------------------------------
# Required: Kiwoom keys. They can place trades, so prefer a paper-trading
# key with MARKET_SYNCER_KIWOOM_MODE=demo.
MARKET_SYNCER_KIWOOM_APP_KEY=
MARKET_SYNCER_KIWOOM_SECRET_KEY=

# Required: OpenDART API key
MARKET_SYNCER_DART_API_KEY=

# real | demo
# MARKET_SYNCER_KIWOOM_MODE=real

# Seconds between pages
# MARKET_SYNCER_KIWOOM_REQUEST_INTERVAL=0.2

# MARKET_SYNCER_LOG_LEVEL=INFO


# -----------------------------------------------------------------------------
#  market-collector
# -----------------------------------------------------------------------------
# Required: Kiwoom account credentials
MARKET_COLLECTOR_KIWOOM_APP_KEY=
MARKET_COLLECTOR_KIWOOM_SECRET_KEY=
MARKET_COLLECTOR_VALKEY_HOST=

# MARKET_COLLECTOR_VALKEY_PORT=6379
# MARKET_COLLECTOR_VALKEY_USERNAME=
# MARKET_COLLECTOR_VALKEY_CACHE_NAME=
# MARKET_COLLECTOR_VALKEY_TLS=false
# MARKET_COLLECTOR_VALKEY_AUTH_MODE=none
# MARKET_COLLECTOR_AWS_REGION=ap-northeast-2

# real | demo
# MARKET_COLLECTOR_KIWOOM_MODE=real

# MARKET_COLLECTOR_INDEX_NAME=KOSPI200

# Seconds between Kiwoom requests (production Compose: 0.25)
# MARKET_COLLECTOR_REQUEST_INTERVAL=1.3

# MARKET_COLLECTOR_LOG_LEVEL=INFO

# Direct runs only (Compose sets it)
# MARKET_COLLECTOR_QUESTDB_CONF=ws::addr=localhost:9000;


# -----------------------------------------------------------------------------
#  market-streamer
# -----------------------------------------------------------------------------
# Required: Kiwoom keys
MARKET_STREAMER_KIWOOM_APP_KEY=
MARKET_STREAMER_KIWOOM_SECRET_KEY=

# real | demo
# MARKET_STREAMER_KIWOOM_MODE=real

# Index whose members are subscribed
# MARKET_STREAMER_INDEX_NAME=KOSPI200

# KST HH:MM. A process started at or after it exits at once.
# MARKET_STREAMER_STOP_AT=15:40

# Price cache. HOST is required for direct runs (Compose sets it).
# MARKET_STREAMER_VALKEY_HOST=
# MARKET_STREAMER_VALKEY_PORT=6379

# none | iam (production Compose: iam, TLS true)
# MARKET_STREAMER_VALKEY_AUTH_MODE=none
# MARKET_STREAMER_VALKEY_TLS=false

# Required with iam: user, ElastiCache serverless cache name, signing region
# MARKET_STREAMER_VALKEY_USERNAME=
# MARKET_STREAMER_VALKEY_CACHE_NAME=
# MARKET_STREAMER_AWS_REGION=ap-northeast-2

# MARKET_STREAMER_LOG_LEVEL=INFO

# Private Prometheus listener. Loopback by default; see docs/operations/2026-10-23-market-prometheus.md.
# MARKET_STREAMER_PROMETHEUS_BIND_HOST=127.0.0.1
# MARKET_STREAMER_PROMETHEUS_PORT=9100

# Tracing is off by default. Only the exact value true disables it (yes/1 leave it on).
# Maps to OTEL_SDK_DISABLED
# MARKET_STREAMER_OTEL_SDK_DISABLED=true
# Maps to OTEL_EXPORTER_OTLP_ENDPOINT (OTLP/HTTP collector, for example Tempo)
# MARKET_STREAMER_OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# Maps to OTEL_TRACES_SAMPLER_ARG (parentbased_traceidratio sampling ratio)
# MARKET_STREAMER_OTEL_TRACES_SAMPLER_ARG=0.1
# Maps to OTEL_RESOURCE_ATTRIBUTES (default: deployment.environment=local in compose.local.yaml, dev in compose.prod.yaml)
# MARKET_STREAMER_OTEL_RESOURCE_ATTRIBUTES=deployment.environment=local


# -----------------------------------------------------------------------------
#  market-http
# -----------------------------------------------------------------------------
# Direct runs only (Compose sets it)
# MARKET_HTTP_QUESTDB_CONF=ws::addr=localhost:9000;connect_timeout=5000;
# MARKET_HTTP_POSTGRES_DSN=postgresql+psycopg://ktb:ktb@localhost:5432/ktb
# MARKET_HTTP_POSTGRES_POOL_SIZE=5
# MARKET_HTTP_POSTGRES_TIMEOUT_SECONDS=5

# Price cache. HOST is required for direct runs and production Compose.
# MARKET_HTTP_VALKEY_HOST=
# MARKET_HTTP_VALKEY_PORT=6379
# Maximum pool connections. Unset preserves redis-py's default pool behavior.
# MARKET_HTTP_VALKEY_MAX_CONNECTIONS=

# none | iam (production Compose: iam, TLS true)
# MARKET_HTTP_VALKEY_AUTH_MODE=none
# MARKET_HTTP_VALKEY_TLS=false

# Required with iam: user, ElastiCache serverless cache name, signing region
# MARKET_HTTP_VALKEY_USERNAME=
# MARKET_HTTP_VALKEY_CACHE_NAME=
# MARKET_HTTP_AWS_REGION=ap-northeast-2

# MARKET_HTTP_HOST=0.0.0.0
# MARKET_HTTP_PORT=8000
# JSON arrays. Set origins to the browser application's exact origin(s). Defaults to [] and blocks CORS requests.
# MARKET_HTTP_CORS_ORIGINS=["https://app.example.com"]
# MARKET_HTTP_CORS_HEADERS=["*"]
# MARKET_HTTP_DOCS_ENABLED=true
# Public prefix stripped by a proxy before requests reach market-http (for example, /market).
# MARKET_HTTP_DOCS_PATH_PREFIX=
# MARKET_HTTP_LOG_LEVEL=INFO

# Private Prometheus listener. Loopback by default; see docs/operations/2026-10-23-market-prometheus.md.
# MARKET_HTTP_PROMETHEUS_BIND_HOST=127.0.0.1
# MARKET_HTTP_PROMETHEUS_PORT=9100

# Tracing is off by default. Only the exact value true disables it (yes/1 leave it on).
# Maps to OTEL_SDK_DISABLED
# MARKET_HTTP_OTEL_SDK_DISABLED=true
# Maps to OTEL_EXPORTER_OTLP_ENDPOINT (OTLP/HTTP collector, for example Tempo)
# MARKET_HTTP_OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# Maps to OTEL_TRACES_SAMPLER_ARG (parentbased_traceidratio sampling ratio)
# MARKET_HTTP_OTEL_TRACES_SAMPLER_ARG=0.01
# Maps to OTEL_RESOURCE_ATTRIBUTES (default: deployment.environment=local in compose.local.yaml, dev in compose.prod.yaml)
# MARKET_HTTP_OTEL_RESOURCE_ATTRIBUTES=deployment.environment=local
# Most SSE deliver spans created per second (sliding window); 0 disables them
# MARKET_HTTP_TRACE_SPANS_PER_SECOND=100


# -----------------------------------------------------------------------------
#  portfolio-builder
# -----------------------------------------------------------------------------
# Required: OpenRouter key and model id
PORTFOLIO_BUILDER_LLM_API_KEY=
PORTFOLIO_BUILDER_LLM_MODEL=

# market-http and news-http base URIs
# PORTFOLIO_BUILDER_MARKET_HTTP_BASE_URI=http://market-http:8000
# PORTFOLIO_BUILDER_NEWS_HTTP_BASE_URI=http://news-http:8000

# none | minimal | low | medium | high | xhigh
# PORTFOLIO_BUILDER_THINKING_LEVEL=medium

# Days of recent news to analyze
# PORTFOLIO_BUILDER_NEWS_WINDOW_DAYS=7

# Max model calls of the portfolio agent
# PORTFOLIO_BUILDER_MAX_TURNS=150

# Explain call: per-tool-result character cap, and max output tokens
# PORTFOLIO_BUILDER_EXPLAIN_RESULT_CHARS=2000
# PORTFOLIO_BUILDER_EXPLAIN_MAX_TOKENS=16000

# PORTFOLIO_BUILDER_LOG_LEVEL=INFO


# -----------------------------------------------------------------------------
#  portfolio-rebalancer
# -----------------------------------------------------------------------------
# Required: Backend base URL for the user lookup
PORTFOLIO_REBALANCER_BACKEND_URL=

# Required: HS256 secret shared with the Backend (at least 32 bytes)
PORTFOLIO_REBALANCER_BACKEND_JWT_SECRET=

# Required: must equal the Backend's JWT_ISSUER
PORTFOLIO_REBALANCER_BACKEND_JWT_ISSUER=

# Required: FIFO queue for order cancellation/creation requests
PORTFOLIO_REBALANCER_ORDER_QUEUE_URL=

AWS_DEFAULT_REGION=ap-northeast-2

# A kept stock trades only when its weight is off target by more than this
# PORTFOLIO_REBALANCER_BAND=0.05

# Buys are sized at last close x (1 + this)
# PORTFOLIO_REBALANCER_BUY_BUFFER=0.02

# true skips the KRX trading-day and -hour check
# PORTFOLIO_REBALANCER_TEST_MODE=false

# PORTFOLIO_REBALANCER_LOG_LEVEL=INFO

# Direct runs only (Compose sets it)
# PORTFOLIO_REBALANCER_QUESTDB_CONF=ws::addr=localhost:9000;


# -----------------------------------------------------------------------------
#  report-builder
# -----------------------------------------------------------------------------
# Not read from this file: local development reads ai.env (compose.local.yaml),
# production reads /etc/stockspoon/ai.env.
# AWS credentials come from the default credential chain.

# Required: SQS queue URL or name
# REPORT_BUILDER_SQS_QUEUE_URL=
# REPORT_BUILDER_AWS_REGION=ap-northeast-2

# Required: Backend callback base URI, shared HS256 secret (>= 32 bytes), issuer
# REPORT_BUILDER_BACKEND_BASE_URI=
# REPORT_BUILDER_BACKEND_JWT_SECRET=
# REPORT_BUILDER_BACKEND_JWT_ISSUER=

# Required: OpenRouter key and model id
# REPORT_BUILDER_LLM_API_KEY=
# REPORT_BUILDER_LLM_MODEL=

# Request timeouts (seconds)
# REPORT_BUILDER_LLM_TIMEOUT=240
# REPORT_BUILDER_BACKEND_TIMEOUT=10

# REPORT_BUILDER_LOG_LEVEL=INFO
