# Copy to .env, then supply real values. Never commit .env or credentials.
POSTGRES_USER=ktb
POSTGRES_DB=ktb
POSTGRES_PASSWORD=
QUESTDB_USER=admin
QUESTDB_PASSWORD=

# Required by the corresponding jobs.
KTB_EMBEDDING_BASE_URI=
NEWS_PREPROCESSOR_DART_API_KEY=
MARKET_SYNCER_KIWOOM_APP_KEY=
MARKET_SYNCER_KIWOOM_SECRET_KEY=
MARKET_SYNCER_DART_API_KEY=
NEWS_GRAPH_BUILDER_LLM_BASE_URI=
NEWS_GRAPH_BUILDER_LLM_MODEL=
MARKET_COLLECTOR_KIWOOM_ACCOUNTS=[]
PORTFOLIO_BUILDER_LLM_API_KEY=
PORTFOLIO_BUILDER_LLM_MODEL=
ORDER_QUEUE_URL=
PORTFOLIO_REBALANCER_ACCOUNT_QUEUE_URL=
PORTFOLIO_REBALANCER_FAILURE_QUEUE_URL=
AWS_DEFAULT_REGION=

